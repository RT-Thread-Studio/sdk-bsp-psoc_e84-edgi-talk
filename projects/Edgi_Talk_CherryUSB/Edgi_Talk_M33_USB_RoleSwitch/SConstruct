SECURE_COMPONENT_HEX = os.path.join(SECURE_BUILD_OUTPUT_DIR, 'rtthread.hex')


def find_root_with(relative_path):
    current = SDK_ROOT
    while True:
        if os.path.exists(os.path.join(current, relative_path)):
            return current

        parent = os.path.dirname(current)
        if parent == current:
            return SDK_ROOT

        current = parent


BSP_ROOT = find_root_with(os.path.join('libs', 'TARGET_APP_KIT_PSE84_EVAL_EPC2'))


def write_secure_boot_config(template_path, output_path, secure_hex_path):
    with open(template_path, 'r') as config_in:
        config = json.load(config_in)

    secure_hex_relpath = os.path.relpath(secure_hex_path, SDK_ROOT).replace(os.sep, '/')
    for item in config.get('content', []):
        if item.get('name') != 'merge':
            continue

        for command in item.get('commands', []):
            inputs = command.get('inputs', [])
            if len(inputs) > 1:
                inputs[1]['file'] = secure_hex_relpath

    output_dir = os.path.dirname(output_path)
    if output_dir and not os.path.exists(output_dir):
        os.makedirs(output_dir)

    with open(output_path, 'w') as config_out:
        json.dump(config, config_out, indent=4)

