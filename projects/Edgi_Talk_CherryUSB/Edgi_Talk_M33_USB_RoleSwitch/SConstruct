SECURE_COMPONENT_NAME = 'infineon-pse84-secure-firmware-latest'
LIBRARIES_ROOT = os.path.dirname(os.path.dirname(libraries_path_prefix))


def resolve_secure_component_dir():
    candidates = [
        os.path.join(SDK_ROOT, 'libraries', 'components', SECURE_COMPONENT_NAME),
        os.path.join(libraries_path_prefix, SECURE_COMPONENT_NAME),
    ]
    current = SDK_ROOT
    while True:
        candidates.append(os.path.join(current, 'libraries', 'components', SECURE_COMPONENT_NAME))
        parent = os.path.dirname(current)
        if parent == current:
            break
        current = parent

    seen = set()
    for candidate in candidates:
        norm = os.path.normcase(os.path.normpath(candidate))
        if norm in seen:
            continue
        seen.add(norm)
        if os.path.exists(candidate):
            return os.path.abspath(candidate)

    return os.path.abspath(candidates[0])


SECURE_COMPONENT_DIR = resolve_secure_component_dir()
SECURE_COMPONENT_SCRIPT = os.path.join(SECURE_COMPONENT_DIR, 'build_secure_fw.py')
DEBUG_DIR = 'build'
