# Generate HEX file
if not os.path.exists(DEBUG_DIR):
    os.makedirs(DEBUG_DIR)
hex_file = env.Command(DEBUG_DIR + '/rtthread_app.hex', TARGET, OBJCOPY + ' -O ihex $SOURCE $TARGET')
secure_fw = env.Command(
    SECURE_COMPONENT_HEX,
    SECURE_COMPONENT_SCRIPT,
    '"' + sys.executable + '" "' + SECURE_COMPONENT_SCRIPT + '" --project-root "' + SDK_ROOT + '" --bsp-root "' + BSP_ROOT + '" --libraries-root "' + LIBRARIES_ROOT + '" --build-dir "' + SECURE_BUILD_WORK_DIR + '" --output-dir "' + SECURE_BUILD_OUTPUT_DIR + '"'
)
env.AlwaysBuild(secure_fw)
env.Depends(hex_file, secure_fw)

# Secure image packaging using edgeprotecttools (Windows only)
if platform.system() == 'Windows':
    # SDK_ROOT is the project directory, go up 3 levels to reach sdk-bsp root
    SDK_BSP_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(SDK_ROOT)))
    EDGEPROTECTTOOLS = os.path.join(SDK_BSP_ROOT, 'tools', 'edgeprotecttools', 'bin', 'edgeprotecttools.exe')
    BOOT_CONFIG_TEMPLATE = os.path.join(SDK_ROOT, 'config', 'boot_with_extended_boot_scons.json')
    BOOT_CONFIG = os.path.join(DEBUG_DIR, 'boot_with_extended_boot_scons.generated.json')

    if os.path.exists(EDGEPROTECTTOOLS) and os.path.exists(BOOT_CONFIG_TEMPLATE):
        write_secure_boot_config(BOOT_CONFIG_TEMPLATE, BOOT_CONFIG, SECURE_COMPONENT_HEX)
        secure_image = env.Command(
            'secure_image',  # Pseudo target
            [hex_file, secure_fw, BOOT_CONFIG],
            '"' + EDGEPROTECTTOOLS + '" run-config -i "' + BOOT_CONFIG + '"'
        )
        env.AlwaysBuild(secure_image)
        Default(secure_image)
    else:
        print("edgeprotecttools or boot config not found, skipping secure image packaging")
        print("EDGEPROTECTTOOLS:", EDGEPROTECTTOOLS)
        print("BOOT_CONFIG_TEMPLATE:", BOOT_CONFIG_TEMPLATE)
