for _stream in (sys.stdout, sys.stderr):
    if hasattr(_stream, 'reconfigure'):
        try:
            _stream.reconfigure(line_buffering=True, write_through=True)
        except Exception:
            pass

PROJECT_ROOT = Dir('.').abspath
PACKAGE_ROOT = os.path.dirname(PROJECT_ROOT)
PACKAGES_ROOT = os.path.dirname(PACKAGE_ROOT)


def default_app_root():
    libraries_dir = os.path.dirname(PACKAGES_ROOT)
    if os.path.basename(PACKAGES_ROOT) == 'components' and os.path.basename(libraries_dir) == 'libraries':
        return os.path.dirname(libraries_dir)

    return os.path.dirname(PACKAGES_ROOT)


def env_path(name, default):
    value = os.environ.get(name)
    if value:
        return os.path.abspath(value)

    return os.path.abspath(default)


def find_root_with(start_dir, relative_path):
    current = os.path.abspath(start_dir)
    while True:
        if os.path.exists(os.path.join(current, relative_path)):
            return current

        parent = os.path.dirname(current)
        if parent == current:
            return os.path.abspath(start_dir)

        current = parent


