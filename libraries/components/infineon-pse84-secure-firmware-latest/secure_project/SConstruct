    os.path.join(BUILD_DIR, 'libraries', 'components', 'mtb-device-support-pse8xxgp', 'pdl', 'drivers', 'source', 'ppu_v1.c'),
]

src += Glob(os.path.join(BUILD_DIR, 'libs', 'TARGET_APP_KIT_PSE84_EVAL_EPC2', 'config', 'GeneratedSource', '*.c'))
src += Glob(os.path.join(BUILD_DIR, 'libs', 'TARGET_APP_KIT_PSE84_EVAL_EPC2', 'COMPONENT_CM33', 'COMPONENT_SECURE_DEVICE', '*.c'))
src += Glob(os.path.join(BUILD_DIR, 'libs', 'TARGET_APP_KIT_PSE84_EVAL_EPC2', 'COMPONENT_CM33', 'TOOLCHAIN_GCC_ARM', '*.c'))
src += Glob(os.path.join(BUILD_DIR, 'libs', 'TARGET_APP_KIT_PSE84_EVAL_EPC2', 'COMPONENT_CM33', 'TOOLCHAIN_GCC_ARM', '*.S'))
src += Glob(os.path.join(BUILD_DIR, 'libraries', 'components', 'async-transfer', 'source', '*.c'))
src += Glob(os.path.join(BUILD_DIR, 'libraries', 'components', 'mtb-ipc', 'source', '*.c'))
src += Glob(os.path.join(BUILD_DIR, 'libraries', 'components', 'Infineon_retarget-io-latest', '*.c'))
src += Glob(os.path.join(BUILD_DIR, 'libraries', 'components', 'mtb-device-support-pse8xxgp', 'device-utils', 'syspm', 'source', '*.c'))
src += Glob(os.path.join(BUILD_DIR, 'libraries', 'components', 'mtb-device-support-pse8xxgp', 'support', 'source', '*.c'))
src += Glob(os.path.join(BUILD_DIR, 'libraries', 'components', 'serial-memory', 'source', '*.c'))
src = unique(src)

elf = env.Program(os.path.join(BUILD_DIR, TARGET), src)
hex_file = env.Command(os.path.join(BUILD_DIR, TARGET + '.hex'), elf, OBJCOPY + ' -O ihex $SOURCE $TARGET')
bin_file = env.Command(os.path.join(BUILD_DIR, TARGET + '.bin'), elf, OBJCOPY + ' -O binary $SOURCE $TARGET')
size_cmd = env.Command('size', elf, SIZE + ' $SOURCE')


def _print_artifact_sizes(target, source, env):
    """Print on-disk size of HEX/BIN so we can see flash footprint at a glance."""
    for tgt in target:
        path = str(tgt)
        if not os.path.isfile(path):
            continue
        size = os.path.getsize(path)
        sys.stdout.write(
            '  {:<10} {:>8} bytes  {:>7.2f} KB\n'.format(
                os.path.basename(path), size, size / 1024.0
            )
        )
        sys.stdout.flush()


env.AddPostAction(hex_file, Action(_print_artifact_sizes, 'print HEX size'))
env.AddPostAction(bin_file, Action(_print_artifact_sizes, 'print BIN size'))

Default([elf, hex_file, bin_file, size_cmd])
Clean(elf, [os.path.join(BUILD_DIR, TARGET + '.map')])
