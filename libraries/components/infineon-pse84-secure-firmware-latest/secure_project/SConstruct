if GCC_MAJOR_VERSION is None or GCC_MAJOR_VERSION < 13:
    # GNU ld from the 10.3.x toolchain does not understand the newer
    # "(READONLY)" output-section attribute syntax and mis-parses it as an
    # address expression.
    linker_script_text = linker_script_text.replace('(READONLY)', '')

