    ASFLAGS=AFLAGS,
    LINKFLAGS=LDFLAGS,
    CPPPATH=CPPPATH,
    CPPDEFINES=CPPDEFINES,
    LIBS=['c', 'm', 'nosys'],
)
env['PROGSUFFIX'] = '.elf'
env['SPAWN'] = ourspawn

