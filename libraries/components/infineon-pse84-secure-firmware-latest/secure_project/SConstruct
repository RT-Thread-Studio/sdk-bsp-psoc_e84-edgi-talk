def tool_path(tool_name):
    executable = PREFIX + tool_name
    if EXEC_PATH:
        return os.path.join(EXEC_PATH, executable)
    return executable


def unique(seq):
    seen = set()
    result = []
    for item in seq:
        norm = os.path.normcase(os.path.normpath(str(item)))
        if norm in seen:
            continue
        seen.add(norm)
        result.append(item)
    return result


def get_gcc_major_version(cc_path):
    version_commands = ([cc_path, '-dumpfullversion'], [cc_path, '-dumpversion'])
    for command in version_commands:
        try:
            process = subprocess.Popen(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            stdout, stderr = process.communicate()
        except OSError:
            continue

        if process.returncode != 0:
            continue

        if not isinstance(stdout, str):
            stdout = stdout.decode('utf-8', 'ignore')

        version_text = stdout.strip()
        if not version_text:
            continue

        major_part = version_text.split('.', 1)[0]
        if major_part.isdigit():
            return int(major_part)

    return None


