def ourspawn(sh, escape, cmd, args, env_vars):
    def dequote_arg(arg):
        arg = str(arg)
        if len(arg) >= 2 and arg[0] == arg[-1] and arg[0] in ('"', "'"):
            return arg[1:-1]
        return arg

    filename = str(uuid.uuid4())
    cmdline = cmd + ' ' + ' '.join(args[1:])
    run_args = [cmd] + [dequote_arg(arg) for arg in args[1:]]
    if len(cmdline) > 16 * 1024:
        with open(filename, 'w') as response_file:
            response_file.write(' '.join(args[1:]).replace('\\', '/'))
        cmdline = cmd + ' @' + filename
        run_args = [cmd, '@' + filename]

    command = cmdline if platform.system() == 'Windows' else run_args

    # Inherit our stdout/stderr so compiler output streams in real time instead
    # of being buffered until the subprocess exits.
    proc = subprocess.Popen(
        command,
        stdin=subprocess.PIPE,
        stdout=None,
        stderr=None,
        shell=False,
        env=env_vars,
    )
    rv = proc.wait()
    if os.path.isfile(filename):
        os.remove(filename)
    return rv


env = Environment(
    tools=['gcc', 'gnulink', 'ar'],
