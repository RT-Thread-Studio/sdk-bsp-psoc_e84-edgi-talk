CPU_FLAGS = '-mcpu=cortex-m33 -mthumb -mfpu=fpv5-sp-d16 -mfloat-abi=softfp'
COMMON_FLAGS = CPU_FLAGS + ' -mcmse -ffunction-sections -fdata-sections'
# Size-oriented build: -Os for code size, -g0 drops debug info (HEX is unaffected
# by -g anyway, but ELF/map get leaner). -fno-unwind-tables removes ARM EH tables
# that aren't needed for plain C firmware code.
CFLAGS = COMMON_FLAGS + ' -Wall -std=gnu11 -O0 -g0 -fno-common -fno-unwind-tables -fno-asynchronous-unwind-tables'
AFLAGS = COMMON_FLAGS + ' -x assembler-with-cpp -c'

